# Nome exibido no Power-Up
VITE_POWERUP_NAME=Calculadora de Tempo de Task

# App Key em https://trello.com/app-key
VITE_POWERUP_APP_KEY=sua_app_key_aqui

# Power-Up ID (opcional — útil para documentação/admin)
VITE_POWERUP_ID=seu_powerup_id_aqui

# Base path do Vite (deixe vazio no local; no GitHub Pages o workflow define sozinho)
# VITE_BASE_PATH=/powerup-calculadora-de-tempo-de-task/
